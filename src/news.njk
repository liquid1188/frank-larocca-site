---
layout: base.njk
title: News
permalink: /news/
---
<h1>News</h1>
<div class="news-list">
{%- for post in collections.news | reverse %}
  <article><h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3><time datetime="{{ post.data.date | isoDate }}">{{ post.data.date | readableDate }}</time></article>
{%- endfor %}
</div>

<h2 class="section-title">Interviews, profiles, and writing</h2>
<ul class="writing">
{%- for w in writing | sort(true, false, "year") %}
  {%- set logo = "" %}{%- for o in press %}{% if o.logo and (o.name in w.outlet) %}{% set logo = o.logo %}{% endif %}{% endfor %}
  <li><span class="w-year">{{ w.year }}</span><div class="w-body"><a href="{{ w.url }}">{{ w.title }}</a><span class="w-outlet">{{ w.outlet }}</span></div><span class="w-logo">{% if logo %}<img src="{{ logo }}" alt="" loading="lazy">{% endif %}</span></li>
{%- endfor %}
</ul>
