---
layout: base.njk
title: Works
permalink: /works/
description: "Catalog of works by Frank La Rocca: Mass settings, motets and propers, choral and instrumental music, with score previews and recordings."
---
<h1>Works</h1>
{%- set cats = ["Mass settings & large works", "SATB a cappella", "SSAA", "Choral–instrumental", "Propers & motets", "Chamber & orchestral"] %}
<ul class="catnav">
{%- for cat in cats %}<li><a href="#{{ cat | slugify }}">{{ cat }}</a></li>{%- endfor %}
</ul>
{%- for cat in cats %}
<h2 class="section-title" id="{{ cat | slugify }}">{{ cat }}</h2>
<ul class="program">
{%- for w in collections.work %}{%- if cat in w.data.categories %}
  <li><span class="t"><a href="{{ w.url }}">{{ w.data.title }}</a></span><span class="leader"></span><span class="f">{{ w.data.forces }}</span></li>
{%- endif %}{%- endfor %}
</ul>
{%- endfor %}
