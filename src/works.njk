---
layout: base.njk
title: Works
permalink: /works/
---
<h1>Works</h1>
{%- set cats = ["SATB a cappella", "SSAA", "Choral–instrumental", "Propers & motets", "Chamber & orchestral"] %}
<nav class="catnav">
{%- for cat in cats %}<a href="#{{ cat | slugify }}">{{ cat }}</a>{%- endfor %}
</nav>
{%- for cat in cats %}
<p class="rubric" id="{{ cat | slugify }}">{{ cat }}</p>
<ul class="program">
{%- for w in collections.work %}{%- if cat in w.data.categories %}
  <li><span class="t"><a href="{{ w.url }}">{{ w.data.title }}</a></span><span class="leader"></span><span class="f">{{ w.data.forces }}</span></li>
{%- endif %}{%- endfor %}
</ul>
{%- endfor %}
