---
pagination:
  data: redirects
  size: 1
  alias: r
permalink: "{{ r.from }}/index.html"
eleventyExcludeFromCollections: true
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta http-equiv="refresh" content="0; url={{ r.to }}"><link rel="canonical" href="{{ site.url }}{{ r.to }}"><meta name="robots" content="noindex"><title>Redirecting</title></head><body><p>Moved to <a href="{{ r.to }}">{{ r.to }}</a>.</p></body></html>
