---
layout: base.njk
eleventyComputed:
  description: "{{ title }} by Frank La Rocca{% if forces %}, {{ forces }}{% endif %}. Score preview, recording, and purchase information."
---
<script type="application/ld+json">{"@context":"https://schema.org","@type":"MusicComposition","name":{{ title | dump | safe }},"composer":{"@type":"Person","name":"Frank La Rocca"}}</script>
{%- if hero %}<figure class="work-hero"><img src="{{ hero }}" alt="{{ heroAlt }}" loading="eager"><figcaption>{{ heroCaption }}</figcaption></figure>{% endif %}
<p class="kicker">{{ categories | join(", ") }}</p>
<h1>{{ title }}</h1>
{%- if forces or year %}<p class="attr">{{ forces }}{% if forces and year %}, {% endif %}{{ year }}</p>{%- endif %}
<div class="work-links">
{%- if preview %}<a href="{{ preview }}">Preview the score</a>{%- endif %}
{%- if audio %}<a href="{{ audio }}">{% if "music.youtube" in audio %}Listen to the album{% else %}Listen{% endif %}</a>{%- endif %}
{%- if video %}<a href="{{ video }}">{% if playlist %}Watch the whole Mass{% elif slug == "missa-pange-lingua" %}Watch the premiere Mass{% else %}Watch{% endif %}</a>{%- endif %}
{%- if purchase %}<a href="{{ purchase }}">{% if "cappella" in purchase %}Buy the album{% else %}Purchase{% endif %}</a>{%- endif %}
{%- if recording %}<a href="{{ recording }}">Recording</a>{%- endif %}
{%- if directors %}<a href="{{ directors }}">Scores and parish edition</a>{%- endif %}
</div>
{%- if content | trim %}
<div style="margin-top:2rem">{{ content | safe }}</div>
{%- endif %}
{%- set vid = video if video else (audio if (audio and "youtu" in audio and "music.youtube" not in audio) else "") %}
{%- if playlist %}
<div class="embed"><iframe loading="lazy" src="https://www.youtube-nocookie.com/embed/videoseries?list={{ playlist }}" title="{{ title }}, complete" allowfullscreen></iframe></div>
{%- elif vid %}
<div class="embed"><iframe loading="lazy" src="https://www.youtube-nocookie.com/embed/{{ vid | ytid }}" title="{{ title }}, recording" allowfullscreen></iframe></div>
{%- endif %}
{%- set cat = categories | first %}
{%- set related = [] %}
{%- for w in collections.work %}{% if w.data.slug != slug and cat in w.data.categories and related.length < 6 %}{% set related = (related.push(w), related) %}{% endif %}{% endfor %}
{%- if related | length %}
<h2 class="section-title" style="margin-top:3rem">More {{ cat | lower }}</h2>
<div class="cards">
{%- for w in related %}{% include "card.njk" %}{% endfor %}
</div>
{%- endif %}
<p style="margin-top:2.5rem"><a class="backlink" href="/works/">All works</a></p>
