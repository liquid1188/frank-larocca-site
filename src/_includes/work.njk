---
layout: base.njk
eleventyComputed:
  description: "{{ title }} by Frank La Rocca{% if forces %}, {{ forces }}{% endif %}. Score preview, recording, and purchase information."
---
<script type="application/ld+json">{"@context":"https://schema.org","@type":"MusicComposition","name":{{ title | dump | safe }},"composer":{"@type":"Person","name":"Frank La Rocca"}}</script>
<p class="kicker">{{ categories | join(", ") }}</p>
<h1>{{ title }}</h1>
{%- if forces or year %}<p class="attr">{{ forces }}{% if forces and year %}, {% endif %}{{ year }}</p>{%- endif %}
<div class="work-links">
{%- if preview %}<a href="{{ preview }}">Preview the score</a>{%- endif %}
{%- if audio %}<a href="{{ audio }}">Listen</a>{%- endif %}
{%- if video %}<a href="{{ video }}">Watch</a>{%- endif %}
{%- if purchase %}<a href="{{ purchase }}">Purchase</a>{%- endif %}
{%- if recording %}<a href="{{ recording }}">Recording</a>{%- endif %}
{%- if directors %}<a href="{{ directors }}">Parish edition</a>{%- endif %}
</div>
{%- if content | trim %}
<div style="margin-top:2rem">{{ content | safe }}</div>
{%- endif %}
{%- set vid = video if video else (audio if (audio and "youtu" in audio) else "") %}
{%- if vid %}
<div class="embed"><iframe loading="lazy" src="https://www.youtube-nocookie.com/embed/{{ vid | ytid }}" title="{{ title }}, recording" allowfullscreen></iframe></div>
{%- endif %}
<p style="margin-top:2.5rem"><a class="backlink" href="/works/">All works</a></p>
