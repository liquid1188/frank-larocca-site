---
layout: base.njk
---
<p class="rubric">{{ categories | join(" · ") }}</p>
<h1>{{ title }}</h1>
{%- if forces %}<p class="attr">{{ forces }}</p>{%- endif %}
<div class="work-links">
{%- if preview %}<a href="{{ preview }}">Preview score</a>{%- endif %}
{%- if audio %}<a href="{{ audio }}">Listen</a>{%- endif %}
{%- if purchase %}<a href="{{ purchase }}">Purchase</a>{%- endif %}
</div>
{%- if audio and "youtu" in audio %}
{%- set vid = audio | replace("https://www.youtube.com/watch?v=", "") | replace("https://youtu.be/", "") %}
<div class="embed"><iframe loading="lazy" src="https://www.youtube-nocookie.com/embed/{{ vid }}" title="{{ title }} — recording" allowfullscreen></iframe></div>
{%- endif %}
{%- if content | trim %}
<p class="rubric" style="margin-top:3rem">Program note</p>
{{ content | safe }}
{%- endif %}
<p style="margin-top:3rem"><a class="backlink" href="/works/">← All works</a></p>
