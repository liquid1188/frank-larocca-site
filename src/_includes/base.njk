<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>(function(){try{if(sessionStorage.getItem("view")==="desktop"){document.querySelector("meta[name=viewport]").setAttribute("content","width=1200");document.documentElement.classList.add("force-desktop");}}catch(e){}})();</script>
  <title>{% if title %}{{ title }} · {% endif %}Frank La Rocca, Composer</title>
  <meta name="description" content="{{ description or 'Sacred choral and instrumental music by Frank La Rocca, Composer-in-Residence at the Benedict XVI Institute for Sacred Music and Divine Worship.' }}">
  <meta property="og:title" content="{% if title %}{{ title }} · {% endif %}Frank La Rocca, Composer">
  <meta property="og:type" content="website">
  <meta property="og:description" content="{{ description or 'Sacred choral and instrumental music by Frank La Rocca.' }}">
  <meta property="og:image" content="{{ site.url }}/images/og-home.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Frank La Rocca, Composer of sacred music">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ site.url }}/images/og-home.jpg">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="stylesheet" href="/css/fonts.css?v={{ buildId }}">
  {%- if page.url == "/" %}<link rel="preload" as="image" imagesrcset="/images/frank-la-rocca-mcgladdery-480.webp 480w, /images/frank-la-rocca-mcgladdery-960.webp 960w, /images/frank-la-rocca-mcgladdery-1327.webp 1327w" imagesizes="(max-width: 900px) 100vw, 52vw" fetchpriority="high">{% endif %}
  {%- if site.setupMode or noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/assets/favicon-180.png">
  <link rel="alternate" type="application/atom+xml" title="Frank La Rocca — News" href="/feed.xml">
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"Person","name":"Frank La Rocca","jobTitle":"Composer","url":"{{ site.url }}/","image":"{{ site.url }}/images/frank-la-rocca-mcgladdery.jpg","affiliation":{"@type":"Organization","name":"Benedict XVI Institute for Sacred Music and Divine Worship"}}</script>
  <link rel="stylesheet" href="/css/style.css?v={{ buildId }}">
</head>
<body{% if page.url == "/" %} class="home"{% endif %}>
  <header class="site-head">
    <div class="wrap">
      <a class="brand" href="/" aria-label="Frank La Rocca, home">{% include "mark.njk" %}<span>Frank La Rocca</span></a>
      <button class="menu-btn" aria-expanded="false" aria-controls="nav">Menu</button>
      <nav class="site-nav" id="nav">
        <a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Home</a>
        <a href="/works/"{% if "/works" in page.url %} aria-current="page"{% endif %}>Works</a>
        <a href="/listen/"{% if "/listen" in page.url %} aria-current="page"{% endif %}>Listen</a>
        <a href="/recordings/"{% if "/recordings" in page.url %} aria-current="page"{% endif %}>Albums</a>
        <a href="/performances/"{% if "/performances" in page.url %} aria-current="page"{% endif %}>Performances</a>
        <a href="/biography/"{% if "/biography" in page.url %} aria-current="page"{% endif %}>Biography</a>
        <a href="/reviews/"{% if "/reviews" in page.url %} aria-current="page"{% endif %}>Reviews</a>
        <a href="/news/"{% if "/news" in page.url %} aria-current="page"{% endif %}>News</a>
        <a href="/contact/"{% if "/contact" in page.url %} aria-current="page"{% endif %}>Contact</a>
      </nav>
    </div>
  </header>
  <main>{% if page.url != "/" and not fullwidth %}<div class="page{% if tags and 'news' in tags %} post{% endif %}"><div class="wrap">{% if tags and 'news' in tags %}<h1>{{ title }}</h1><p class="note"><time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time></p>{% endif %}{{ content | safe }}</div></div>{% else %}{{ content | safe }}{% endif %}</main>
  <footer class="site-foot">
    <div class="wrap">
      <a class="foot-brand" href="/">{% include "mark-wide.njk" %}<span class="foot-name">Frank La Rocca</span><span class="foot-rule" aria-hidden="true"></span><span class="foot-role">Composer of sacred music</span></a>
      <nav aria-label="Footer">
        <span class="row"><a href="/">Home</a><a href="/works/">Works</a><a href="/listen/">Listen</a><a href="/recordings/">Albums</a></span>
        <span class="row"><a href="/performances/">Performances</a><a href="/biography/">Biography</a><a href="/reviews/">Reviews</a></span>
        <span class="row"><a href="/news/">News</a><a href="/directors/">For directors</a><a href="/contact/">Contact</a></span>
      </nav>
      {% include "icons.njk" %}
      <p class="foot-inst"><span>Composer-in-Residence,</span> <a href="{{ site.institute }}">Benedict XVI Institute for Sacred Music and Divine Worship</a></p>
      <a class="btn foot-support" href="{{ site.instituteDonate }}">Support the Institute</a>
      <div class="foot-hair"></div>
      <p class="foot-small">© <span id="year">{{ today | truncate(4, true, "") }}</span> Frank La Rocca · <a class="signin" href="/admin/">Sign in</a> <span class="view-toggle-sep">·</span> <button type="button" class="view-toggle" id="view-toggle">View desktop version</button></p>
      <p class="foot-small colophon"><a href="https://lickitysplitweb.com">Site by Lickity Split Web Design</a></p>
    </div>
  </footer>
  <script>(function(){var b=document.getElementById("view-toggle");if(!b)return;var d=document.documentElement.classList.contains("force-desktop");b.textContent=d?"View mobile version":"View desktop version";b.addEventListener("click",function(){try{sessionStorage.setItem("view",d?"mobile":"desktop");}catch(e){}location.reload();});})();</script>
  <script>
    (function(){var b=document.querySelector('.menu-btn'),n=document.getElementById('nav');if(!b)return;
    b.addEventListener('click',function(){var o=n.classList.toggle('open');b.setAttribute('aria-expanded',o);b.textContent=o?'Close':'Menu';});})();
    (function(){var y=document.getElementById('year');if(y)y.textContent=new Date().getFullYear();})();
    (function(){if(!('IntersectionObserver' in window))return;var els=document.querySelectorAll('.band, .card, .album, .feature, .section-title');els.forEach(function(e){e.classList.add('reveal')});var io=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target)}})},{threshold:.06});els.forEach(function(e){io.observe(e)});setTimeout(function(){els.forEach(function(e){e.classList.add('in')})},2500);})();
  </script>
</body>
</html>
