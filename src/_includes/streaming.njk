{%- if r.links.label %}<a href="{{ r.links.label }}">Label</a>{% endif %}
{%- if r.links.spotify %}<a href="{{ r.links.spotify }}">Spotify</a>{% endif %}
{%- if r.links.apple %}<a href="{{ r.links.apple }}">Apple Music</a>{% endif %}
{%- if r.links.amazon %}<a href="{{ r.links.amazon }}">{% if r.id == "in-this-place" %}CD on Amazon, with booklet{% else %}Amazon{% endif %}</a>{% endif %}
