{%- if r.links.notes %}<a href="{{ r.links.notes }}">Liner notes</a>{% endif %}
{%- if r.links.videos %}<a href="{{ r.links.videos }}">Videos</a>{% endif %}
{%- if r.links.stream %}<a href="{{ r.links.stream }}">All streaming services</a>{% endif %}
