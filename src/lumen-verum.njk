---
layout: base.njk
title: Lumen Verum Music
permalink: /lumen-verum/
fullwidth: true
description: "Lumen Verum Music, the publishing imprint of composer Frank La Rocca. Catalog of scores with perusal and request information."
eleventyExcludeFromCollections: true
---
<section class="soon lv-head">
  <div class="wrap">
    <img class="soon-mark" src="/images/affil/lumen-verum-music.svg" alt="Lumen Verum Music" width="150" height="84">
    <h1>Lumen Verum Music</h1>
    <p class="lv-lede">The publishing imprint of Frank La Rocca.</p>
    {%- if not site.lvCatalog %}
    <p style="margin-top:1.4rem">A catalog of scores is coming. Until then, performance materials for works published by Lumen Verum Music are available by request.</p>
    <p><a class="btn primary" href="mailto:{{ site.materialsEmail }}?subject=Score%20request">{{ site.materialsEmail }}</a></p>
    {%- endif %}
  </div>
</section>
{%- if site.lvCatalog %}
{%- set groups = [
  ["Motets and anthems", ["SATB a cappella", "Propers & motets"], "nopropers"],
  ["Choral propers", ["Propers & motets"]],
  ["Choral with instruments", ["Choral–instrumental"]],
  ["Treble voices", ["SSAA"]],
  ["Chamber and orchestral", ["Chamber & orchestral"]]
] %}
{%- set placed = [] %}
<section class="band light lv-catalog">
  <div class="wrap">
  {%- for g in groups %}
    {%- set rows = [] %}
    {%- for w in collections.work %}
      {%- if w.data.publisher == "Lumen Verum Music" and w.data.slug not in placed %}
        {%- set hit = false %}
        {%- for c in g[1] %}{% if c in w.data.categories %}{% set hit = true %}{% endif %}{% endfor %}
        {%- if g[2] == "nopropers" and w.data.motet %}{% set hit = false %}{% endif %}
        {%- if hit %}{% set rows = (rows.push(w), rows) %}{% set placed = (placed.push(w.data.slug), placed) %}{% endif %}
      {%- endif %}
    {%- endfor %}
    {%- if rows | length %}
    <div class="lv-group">
    <h2 class="lv-group-title">{{ g[0] }}</h2>
    <ul class="lv-list">
    {%- for w in rows | lvSort %}
      {%- set name = w.data.motet or w.data.title %}
      <li>
        <div class="lv-title"><a href="{{ w.url }}">{{ name }}</a></div>
        {%- if w.data.motet or w.data.forces %}<div class="lv-forces">{% if w.data.motet %}{{ w.data.title }}{% if w.data.forces %}, {% endif %}{% endif %}{{ w.data.forces }}</div>{% endif %}
        <div class="lv-links">
          {%- if w.data.perusal %}<a href="{{ w.data.perusal }}">Perusal score</a>{% elif w.data.preview %}<a href="{{ w.data.preview }}">Preview score</a>{% endif %}
          {%- if w.data.audio %}<a href="{{ w.data.audio }}">Listen</a>{% elif w.data.video %}<a href="{{ w.data.video }}">Watch</a>{% endif %}
          <a class="lv-req" href="mailto:{{ site.materialsEmail }}?subject=Score%20request%20for%20{{ name | urlencode }}&body=Dear%20Dr.%20La%20Rocca%2C%0A%0AI%20would%20like%20to%20request%20performance%20copies%20of%20{{ name | urlencode }}.%0A%0AEnsemble%3A%20%0ACity%3A%20%0ANumber%20of%20copies%3A%20%0A%0AThank%20you%2C%0A">Request</a>
        </div>
      </li>
    {%- endfor %}
    </ul>
    </div>
    {%- endif %}
  {%- endfor %}
  </div>
</section>
<section class="band lv-order">
  <div class="wrap">
  <div class="lv-order-inner">
    <h2 class="section-title">Ordering</h2>
    <p>Write with the work, your ensemble, and the number of copies you need.</p>
    <a class="btn primary" href="mailto:{{ site.materialsEmail }}?subject=Score%20request&body=Dear%20Dr.%20La%20Rocca%2C%0A%0AI%20would%20like%20to%20request%20performance%20copies%20of%20the%20following%20work%3A%20.%0A%0AEnsemble%3A%20%0ACity%3A%20%0ANumber%20of%20copies%3A%20%0A%0AThank%20you%2C%0A">{{ site.materialsEmail }}</a>
  </div>
  </div>
</section>
{%- endif %}
