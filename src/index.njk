---
layout: base.njk
description: "Frank La Rocca, composer of sacred choral and instrumental music. Composer-in-Residence at the Benedict XVI Institute and composer of the Mass of the Americas."
---
<section class="hero">
  <div class="wrap">
    <div class="hero-copy">
      <h1>Frank<br>La Rocca</h1>
      <p class="role">Composer of sacred music</p>
      <p class="lede">Composer-in-Residence at the Benedict XVI Institute. His <em>Mass of the Americas</em> debuted at number one on the Billboard Traditional Classical chart.</p>
      <div class="actions">
        <button class="btn primary" id="listen" aria-expanded="false" aria-controls="player">Listen to the Mass of the Americas</button>
        <a class="btn" href="/works/">Browse the catalog</a>
      </div>
    </div>
    <div class="hero-portrait">
      <img src="/images/frank-la-rocca.jpg" alt="Frank La Rocca" width="1206" height="1172" fetchpriority="high">
    </div>
  </div>
  <div class="staff"></div>
</section>

<div class="player" id="player">
  <div class="wrap">
    <div class="embed"><iframe data-src="https://www.youtube-nocookie.com/embed/JECDSmQU7AQ?autoplay=1" title="Mass of the Americas, preview" allow="autoplay; encrypted-media" allowfullscreen></iframe></div>
    <p class="meta"><strong>Mass of the Americas</strong>Benedict XVI Choir and Orchestra, Richard Sparks, conductor. Cappella Records, 2022. <a href="/recordings/">All recordings</a></p>
  </div>
</div>

<section class="band light pull">
  <div class="wrap">
    <blockquote>
      <p>Perhaps the most significant Catholic composition of our lifetimes.</p>
      <cite>Michael Olbash, on the <em>Mass of the Americas</em></cite>
    </blockquote>
    <ul class="press-strip" aria-label="Reviewed in">
      <li>American Record Guide</li><li>Fanfare</li><li>Billboard</li><li>Catholic World Report</li><li>New Liturgical Movement</li>
    </ul>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <div class="band-head"><h2>Selected works</h2><a class="more" href="/works/">All {{ collections.work | length }} works</a></div>
    <div class="cards three">
    {%- for slug in featured | batch(3) | first %}{% set w = collections.work | bySlug(slug) %}{% if w %}{% include "card.njk" %}{% endif %}{% endfor %}
    </div>
  </div>
</section>

<section class="band light">
  <div class="wrap">
    <div class="band-head"><h2>Recordings</h2><a class="more" href="/recordings/">All recordings</a></div>
    <div class="albums">
      <div class="album">
        <img src="/images/mass-of-the-americas-cover.jpg" alt="Album cover, Mass of the Americas" width="1200" height="1200" loading="lazy">
        <div>
          <h3>Mass of the Americas</h3>
          <p class="label">Cappella Records, 2022</p>
          <p>Benedict XVI Choir and Orchestra, Richard Sparks. Sung in Latin, Spanish, and Nahuatl.</p>
          <p class="links"><a href="https://cappellarecords.com/recording/frank-la-rocca-mass-of-the-americas/">Cappella Records</a></p>
        </div>
      </div>
      <div class="album">
        <img src="/images/requiem-forgotten-cover.jpg" alt="Album cover, Requiem for the Forgotten and Messe des Malades" width="1200" height="1200" loading="lazy">
        <div>
          <h3>Requiem for the Forgotten<br>Messe des Malades</h3>
          <p class="label">Cappella Records, 2024</p>
          <p>Benedict XVI Choir and Orchestra, Richard Sparks. A Requiem for the homeless, and a Mass for the sick.</p>
          <p class="links"><a href="https://cappellarecords.com/recording/requiem-for-the-forgotten-messe-des-malades/">Cappella Records</a></p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="band">
  <div class="wrap two-up">
    {%- set upcoming = [] %}{% set past = [] %}
    {%- for e in events %}{% if e.iso >= today %}{% set upcoming = (upcoming.push(e), upcoming) %}{% else %}{% set past = (past.push(e), past) %}{% endif %}{% endfor %}
    <div>
      <div class="band-head"><h2>{% if upcoming | length %}Upcoming{% else %}Recent performances{% endif %}</h2><a class="more" href="/performances/">All performances</a></div>
      <ul class="dates{% if not upcoming | length %} past{% endif %}">
      {%- set shown = upcoming if upcoming | length else (past | reverse) %}
      {%- for e in shown | batch(3) | first %}
        <li><span class="when">{{ e.iso | shortDate }}</span><div><div class="what">{{ e.work }}</div><p class="where">{{ e.venue }}, {{ e.city }}</p></div></li>
      {%- endfor %}
      </ul>
    </div>
    <div>
      <div class="band-head"><h2>News</h2><a class="more" href="/news/">All news</a></div>
      <ul class="dates">
      {%- for post in collections.news | reverse | batch(3) | first %}
        <li><span class="when">{{ post.data.date | shortDate }}</span><div><div class="what"><a href="{{ post.url }}" style="text-decoration:none">{{ post.data.title }}</a></div></div></li>
      {%- endfor %}
      </ul>
    </div>
  </div>
</section>

<script>
  (function(){var b=document.getElementById('listen'),p=document.getElementById('player'),f=p.querySelector('iframe');
  b.addEventListener('click',function(){var o=p.classList.toggle('open');b.setAttribute('aria-expanded',o);
    if(o){if(!f.src)f.src=f.dataset.src;b.textContent='Close the player';p.scrollIntoView({behavior:'smooth',block:'start'});}
    else{f.src='';f.removeAttribute('src');b.textContent='Listen to the Mass of the Americas';}});})();
</script>
