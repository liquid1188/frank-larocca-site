---
layout: base.njk
description: "Frank La Rocca, composer of sacred choral and instrumental music. Composer-in-Residence at the Benedict XVI Institute and composer of the Mass of the Americas."
---
<section class="hero">
  <p class="hero-epigraph">&ldquo;Late have I loved you, O<br>Beauty ever ancient, ever new,<br>late have I loved you!&rdquo; <span>St. Augustine</span></p>
  <div class="wrap">
    <div class="hero-copy">
      <h1>Frank<br>La Rocca</h1>
      <p class="role">Composer of sacred music</p>
      <p class="hero-line">The sound of spiritual sorrow transformed by grace.</p>
      <p class="lede">Composer-in-Residence at the <a href="{{ site.instituteComposerPage }}">Benedict XVI Institute</a> and composer of the <em>Mass of the Americas</em>.</p>
      <div class="actions">
        <button class="btn primary" id="listen" aria-expanded="false" aria-controls="player">Listen to the Mass of the Americas</button>
        <a class="btn" href="/works/">Browse the catalog</a>
      </div>
    </div>
    <div class="hero-portrait">
      <img src="/images/frank-la-rocca-mcgladdery.jpg" alt="Frank La Rocca" width="1327" height="1327" fetchpriority="high">
      <p class="hero-credit">Photograph by Kevin McGladdery</p>
    </div>
  </div>
  {% include "staff-rule.njk" %}
</section>

<div class="player" id="player">
  <div class="wrap">
    <div class="embed"><iframe data-src="https://www.youtube-nocookie.com/embed/videoseries?list=PLgth7UAnTn5_zIp4s0AXQjDshFn35qdRI" title="Mass of the Americas, preview" allow="autoplay; encrypted-media" allowfullscreen></iframe></div>
    <div class="meta"><strong>Mass of the Americas</strong><p>The complete Mass in order, from the entrance hymn to the Salve Regina. Benedict XVI Choir and Orchestra, Richard Sparks, at the Basilica of the National Shrine of the Immaculate Conception, Washington, 2019.</p>
      <div class="actions"><a class="btn" href="https://www.youtube.com/playlist?list=PLgth7UAnTn5_zIp4s0AXQjDshFn35qdRI">Watch the whole Mass</a><a class="btn" href="/recordings/#mass-of-the-americas">The recording</a><a class="btn" href="/listen/">All performances</a></div>
    </div>
  </div>
</div>

<section class="feature">
  <img class="feature-img" src="/images/mass-of-the-americas-nyc-2022.jpg" alt="" width="2397" height="1600" loading="lazy">
  <div class="wrap">
    <div class="feature-copy">
      <p class="kicker">Mass of the Americas</p>
      <h2>A Mass for Our Lady of Guadalupe and the Immaculate Conception</h2>
      <p>Commissioned by Archbishop Cordileone, sung in Latin, Spanish, and Nahuatl, and celebrated from the National Shrine of the Immaculate Conception in Washington to the Basilica of Guadalupe in Mexico City.</p>
      <div class="actions"><a class="btn primary" href="/works/mass-of-the-americas/">About the Mass</a><a class="btn" href="{{ site.instituteDonate }}">Support the Institute</a></div>
    </div>
  </div>
  <p class="credit"><span>Mass of the Americas, New York, 2022.</span> <span>Photograph by Jeffrey Bruno, courtesy of the Benedict XVI Institute.</span></p>
</section>

<section class="band light pull">
  <div class="wrap">
    <blockquote class="marked">
      <span class="qmark" aria-hidden="true">&ldquo;</span>
      <p>&ldquo;{{ endorsements[0].quote }}&rdquo;</p>
      <cite>{% if endorsements[0].url %}<a href="{{ endorsements[0].url }}">{% endif %}{{ endorsements[0].name }}, {{ endorsements[0].title }}{% if endorsements[0].url %}</a>{% endif %}</cite>
    </blockquote>
    <div class="quotes-two">
    {%- for e in endorsements | batch(3) | first %}{% if not loop.first %}
      <blockquote><p>&ldquo;{{ e.quote }}&rdquo;</p><cite>{% if e.url %}<a href="{{ e.url }}">{% endif %}{{ e.name }}, {{ e.title }}{% if e.url %}</a>{% endif %}</cite></blockquote>
    {%- endif %}{% endfor %}
    </div>
    {%- set homepress = [] %}{% for o in press %}{% if o.home %}{% set homepress = (homepress.push(o), homepress) %}{% endif %}{% endfor %}
    <div class="press-strip-wrap" aria-label="Reviewed in">
    {%- for row in homepress | batch(4) %}
    <ul class="press-strip{% if not loop.first %} continued{% endif %}">
    {%- for o in row %}<li class="{% if o.raw %}raw {% endif %}{% if o.small %}small{% endif %}">{% if o.logo %}<img src="{{ o.logo }}" alt="{{ o.name }}">{% else %}{{ o.name }}{% endif %}</li>{% endfor %}
    </ul>
    {%- endfor %}
    </div>
  </div>
</section>

<section class="band watch">
  <div class="wrap">
    {%- set feat = videos | selectattr("featured") | first %}
    <div class="band-head"><h2>In his own words</h2><a class="more" href="/listen/">More videos</a></div>
    <div class="watch-grid">
      <div class="watch-main">
        <div class="embed"><iframe loading="lazy" src="https://www.youtube-nocookie.com/embed/{{ feat.id }}" title="{{ feat.title }}" allowfullscreen></iframe></div>
        <p class="watch-cap"><strong>{{ feat.title }}</strong> {{ feat.source }}</p>
      </div>
      <ul class="watch-list">
      {%- for v in videos %}{% if v.kind == "talk" and not v.featured %}
        <li><a href="https://www.youtube.com/watch?v={{ v.id }}"><img src="https://img.youtube.com/vi/{{ v.id }}/mqdefault.jpg" alt="" loading="lazy" width="320" height="180"><span><strong>{{ v.title }}</strong>{{ v.source }}</span></a></li>
      {%- endif %}{% endfor %}
      </ul>
    </div>
  </div>
</section>

<section class="band light">
  <div class="wrap">
    <div class="band-head"><h2>Selected works</h2><a class="more" href="/works/">All {{ collections.work | length }} works</a></div>
    <div class="cards three">
    {%- for slug in featured | batch(3) | first %}{% set w = collections.work | bySlug(slug) %}{% if w %}{% include "card.njk" %}{% endif %}{% endfor %}
    </div>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <div class="band-head"><h2>Albums</h2><a class="more" href="/recordings/">All albums</a></div>
    <p class="band-lede">Both Cappella Records albums debuted at number one on Billboard's Traditional Classical chart.</p>
    <div class="albums">
    {%- for r in recordings | sort(true, false, "year") | batch(2) | first %}
      <div class="album">
        {% if r.cover %}<img src="{{ r.cover }}" alt="Album cover, {{ r.title }}" width="1200" height="1200" loading="lazy">{% else %}<div class="cover-blank"></div>{% endif %}
        <div>
          <h3>{{ r.title | replace(" · ", "<br>") | safe }}</h3>
          <p class="label">{{ r.label }}, {{ r.year }}</p>
          <p class="links">{% include "streaming.njk" %}</p>
        </div>
      </div>
    {%- endfor %}
    </div>
  </div>
</section>

<section class="band light affil">
  <div class="wrap">
    <div class="band-head"><h2>Affiliations</h2></div>
    {%- set logos = [] %}{% for a in affiliations %}{% if a.logo %}{% set logos = (logos.push(a), logos) %}{% endif %}{% endfor %}
    {%- for row in logos | batch(6) %}
    <ul class="logo-row">
    {%- for a in row %}<li class="{% if a.raw %}raw {% endif %}{% if a.mono %}mono {% endif %}{% if a.square %}square {% endif %}{% if a.wide %}wide{% endif %}"><a href="{{ a.url }}" title="{{ a.name }}, {{ a.role }}"><img src="{{ a.logo }}" alt="{{ a.name }}"></a></li>{% endfor %}
    </ul>
    {%- endfor %}
  </div>
</section>

<section class="band light">
  <div class="wrap two-up">
    {%- set upcoming = [] %}{% set past = [] %}
    {%- for e in collections.eventsSorted %}{% if e.iso >= today %}{% set upcoming = (upcoming.push(e), upcoming) %}{% else %}{% set past = (past.push(e), past) %}{% endif %}{% endfor %}
    <div>
      <div class="band-head"><h2>{% if upcoming | length %}Upcoming{% else %}Recent performances{% endif %}</h2><a class="more" href="/performances/">All performances</a></div>
      <ul class="dates{% if not upcoming | length %} past{% endif %}">
      {%- set shown = (upcoming | sort(false, false, "iso")) if upcoming | length else (past | sort(true, false, "iso")) %}
      {%- for e in shown | batch(3) | first %}
        <li><span class="when">{{ e.iso | shortDate }}</span><div><div class="what">{{ e.work }}</div><p class="where">{{ e.venue }}, {{ e.city }}</p></div></li>
      {%- endfor %}
      </ul>
    </div>
    <div>
      <div class="band-head"><h2>News</h2><a class="more" href="/news/">All news</a></div>
      {%- set items = [] %}
      {%- for w in writing %}{% set items = (items.push({ year: w.year, sort: w.year * 10000 + 5000, title: w.title, url: w.url, outlet: w.outlet }), items) %}{% endfor %}
      {%- for p in collections.latestNews %}{% set items = (items.push({ year: p.year, sort: p.year * 10000, title: p.title, url: p.url, outlet: "" }), items) %}{% endfor %}
      <ul class="dates">
      {%- for n in items | sort(true, false, "sort") | batch(3) | first %}
        <li><span class="when">{{ n.year }}</span><div><div class="what"><a href="{{ n.url }}" style="text-decoration:none">{{ n.title }}</a></div>{% if n.outlet %}<p class="where">{{ n.outlet }}</p>{% endif %}</div></li>
      {%- endfor %}
      </ul>
    </div>
  </div>
</section>

<script>
  (function(){var b=document.getElementById('listen'),p=document.getElementById('player'),f=p.querySelector('iframe');
  b.addEventListener('click',function(){var o=p.classList.toggle('open');b.setAttribute('aria-expanded',o);
    if(o){if(!f.getAttribute('src'))f.src=f.dataset.src;b.textContent='Close the player';setTimeout(function(){p.scrollIntoView({behavior:'smooth',block:'start'});},50);}
    else{f.src='';f.removeAttribute('src');b.textContent='Listen to the Mass of the Americas';}});})();
</script>
