---
layout: base.njk
description: "Frank La Rocca, composer of sacred choral and instrumental music. Composer-in-Residence at the Benedict XVI Institute and composer of the Mass of the Americas."
---
<section class="hero">
  <div class="wrap">
    <div class="hero-copy">
      <h1>Frank<br>La Rocca</h1>
      <p class="role">Composer of sacred music</p>
      <p class="lede">Composer-in-Residence at the <a href="{{ site.instituteComposerPage }}">Benedict XVI Institute</a>. His <em>Mass of the Americas</em> debuted at number one on the Billboard Traditional Classical chart.</p>
      <div class="actions">
        <button class="btn primary" id="listen" aria-expanded="false" aria-controls="player">Listen to the Mass of the Americas</button>
        <a class="btn" href="/works/">Browse the catalog</a>
      </div>
    </div>
    <div class="hero-portrait">
      <img src="/images/frank-la-rocca-mcgladdery.jpg" alt="Frank La Rocca" width="1327" height="1327" fetchpriority="high">
      <p class="hero-credit">Photograph by Kevin McGladdery</p>
    </div>
  </div>
  {% include "staff-rule.njk" %}
</section>

<div class="player" id="player">
  <div class="wrap">
    <div class="embed"><iframe data-src="https://www.youtube-nocookie.com/embed/JECDSmQU7AQ" title="Mass of the Americas, preview" allow="autoplay; encrypted-media" allowfullscreen></iframe></div>
    <p class="meta"><strong>Mass of the Americas</strong>Benedict XVI Choir and Orchestra, Richard Sparks, conductor. Cappella Records, 2022. <a href="/recordings/">All recordings</a></p>
  </div>
</div>

<section class="feature" style="--img:url('/images/mass-of-the-americas-nyc-2022.jpg')">
  <div class="wrap">
    <div class="feature-copy">
      <p class="kicker">Mass of the Americas</p>
      <h2>A Mass for Our Lady of Guadalupe and the Immaculate Conception</h2>
      <p>Commissioned by Archbishop Cordileone, sung in Latin, Spanish, and Nahuatl, and celebrated from the National Shrine in Washington to the Basilica of Guadalupe in Mexico City.</p>
      <div class="actions"><a class="btn primary" href="/works/mass-of-the-americas/">About the Mass</a><a class="btn" href="{{ site.instituteDonate }}">Support the Institute</a></div>
    </div>
  </div>
  <p class="credit">Mass of the Americas, New York, 2022. Photograph by Jeffrey Bruno, courtesy of the Benedict XVI Institute.</p>
</section>

<section class="band light pull">
  <div class="wrap">
    <blockquote class="marked">
      <span class="qmark" aria-hidden="true">&ldquo;</span>
      <p>{{ endorsements[0].quote }}</p>
      <cite>{{ endorsements[0].name }}, {{ endorsements[0].title }}</cite>
    </blockquote>
    <div class="quotes-two">
    {%- for e in endorsements | batch(3) | first %}{% if not loop.first %}
      <blockquote><p>{{ e.quote }}</p><cite>{{ e.name }}, {{ e.title }}</cite></blockquote>
    {%- endif %}{% endfor %}
    </div>
    <ul class="press-strip" aria-label="Reviewed in">
    {%- for o in press %}{% if o.home %}<li class="{% if o.raw %}raw {% endif %}{% if o.small %}small{% endif %}">{% if o.logo %}<img src="{{ o.logo }}" alt="{{ o.name }}">{% else %}{{ o.name }}{% endif %}</li>{% endif %}{% endfor %}
    </ul>
  </div>
</section>

<section class="band watch">
  <div class="wrap">
    {%- set feat = videos | selectattr("featured") | first %}
    <div class="band-head"><h2>In his own words</h2><a class="more" href="/listen/">More videos</a></div>
    <div class="watch-one">
      <div class="embed"><iframe loading="lazy" src="https://www.youtube-nocookie.com/embed/{{ feat.id }}" title="{{ feat.title }}" allowfullscreen></iframe></div>
      <p class="watch-cap"><strong>{{ feat.title }}</strong> {{ feat.source }}</p>
    </div>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <div class="band-head"><h2>Selected works</h2><a class="more" href="/works/">All {{ collections.work | length }} works</a></div>
    <div class="cards three">
    {%- for slug in featured | batch(3) | first %}{% set w = collections.work | bySlug(slug) %}{% if w %}{% include "card.njk" %}{% endif %}{% endfor %}
    </div>
  </div>
</section>

<section class="band light">
  <div class="wrap">
    <div class="band-head"><h2>Albums</h2><a class="more" href="/recordings/">All albums</a></div>
    <div class="albums">
    {%- for r in recordings | batch(2) | first %}
      <div class="album">
        {% if r.cover %}<img src="{{ r.cover }}" alt="Album cover, {{ r.title }}" width="1200" height="1200" loading="lazy">{% else %}<div class="cover-blank"></div>{% endif %}
        <div>
          <h3>{{ r.title | replace(" · ", "<br>") | safe }}</h3>
          <p class="label">{{ r.label }}, {{ r.year }}</p>
          <p class="links">{% include "streaming.njk" %}</p>
        </div>
      </div>
    {%- endfor %}
    </div>
  </div>
</section>

<section class="band affil">
  <div class="wrap">
    <div class="band-head"><h2>Affiliations</h2></div>
    <ul class="logo-row">
    {%- for a in affiliations %}{% if a.logo %}<li class="{% if a.raw %}raw {% endif %}{% if a.square %}square {% endif %}{% if a.wide %}wide{% endif %}"><a href="{{ a.url }}" title="{{ a.name }}, {{ a.role }}"><img src="{{ a.logo }}" alt="{{ a.name }}"></a></li>{% endif %}{% endfor %}
    </ul>
    <p class="note center">Also faculty at the Catholic Institute of Sacred Music, and published by Lumen Verum Music.</p>
  </div>
</section>

<section class="band">
  <div class="wrap two-up">
    {%- set upcoming = [] %}{% set past = [] %}
    {%- for e in events %}{% if e.iso >= today %}{% set upcoming = (upcoming.push(e), upcoming) %}{% else %}{% set past = (past.push(e), past) %}{% endif %}{% endfor %}
    <div>
      <div class="band-head"><h2>{% if upcoming | length %}Upcoming{% else %}Recent performances{% endif %}</h2><a class="more" href="/performances/">All performances</a></div>
      <ul class="dates{% if not upcoming | length %} past{% endif %}">
      {%- set shown = (upcoming | sort(false, false, "iso")) if upcoming | length else (past | sort(true, false, "iso")) %}
      {%- for e in shown | batch(3) | first %}
        <li><span class="when">{{ e.iso | shortDate }}</span><div><div class="what">{{ e.work }}</div><p class="where">{{ e.venue }}, {{ e.city }}</p></div></li>
      {%- endfor %}
      </ul>
    </div>
    <div>
      <div class="band-head"><h2>News</h2><a class="more" href="/news/">All news</a></div>
      <ul class="dates">
      {%- for post in collections.news | reverse | batch(3) | first %}
        <li><span class="when">{{ post.data.date | shortDate }}</span><div><div class="what"><a href="{{ post.url }}" style="text-decoration:none">{{ post.data.title }}</a></div></div></li>
      {%- endfor %}
      </ul>
    </div>
  </div>
</section>

<script>
  (function(){var b=document.getElementById('listen'),p=document.getElementById('player'),f=p.querySelector('iframe');
  b.addEventListener('click',function(){var o=p.classList.toggle('open');b.setAttribute('aria-expanded',o);
    if(o){if(!f.getAttribute('src'))f.src=f.dataset.src;b.textContent='Close the player';setTimeout(function(){p.scrollIntoView({behavior:'smooth',block:'start'});},50);}
    else{f.src='';f.removeAttribute('src');b.textContent='Listen to the Mass of the Americas';}});})();
</script>
