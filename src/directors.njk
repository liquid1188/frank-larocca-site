<h2 class="section-title">Mass of the Americas</h2>
<p>Four editions: Extraordinary Form (Latin, 1962 Missal), Ordinary Form (Spanish, Latin, English, and Nahuatl), a hybrid Ordinary Form with Greek Kyrie and Latin Agnus Dei, and the parish edition for chorus and organ. Scores are licensed per printed copy and delivered electronically with a license to print; order enough for choir, conductor, and organist, sixteen at minimum. Perusal copies of any edition are free on request.</p>
<form class="form perusal" id="perusal" action="https://formsubmit.co/{{ site.materialsEmail }}" method="POST" data-thanks="Thank you. Your perusal request has been sent; the score will follow by email.">
  <input type="hidden" name="_subject" value="Perusal request, Mass of the Americas">
  <input type="hidden" name="_captcha" value="false">
  <input type="hidden" name="_next" value="{{ site.url }}/directors/?sent=1">
  <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">
  <div class="two-up tight">
    <label>Your name<input type="text" name="name" required autocomplete="name"></label>
    <label>Email<input type="email" name="email" required autocomplete="email"></label>
    <label>Parish, cathedral, or organization<input type="text" name="organization"></label>
    <label>Your role<input type="text" name="title" placeholder="Music director, pastor, conductor"></label>
  </div>
  <fieldset><legend>Edition</legend>
    <label class="check"><input type="checkbox" name="edition" value="Extraordinary Form"> Extraordinary Form</label>
    <label class="check"><input type="checkbox" name="edition" value="Ordinary Form"> Ordinary Form</label>
    <label class="check"><input type="checkbox" name="edition" value="Hybrid"> Hybrid</label>
    <label class="check"><input type="checkbox" name="edition" value="Parish edition"> Parish edition</label>
  </fieldset>
  <label>Message<textarea name="message" rows="4"></textarea></label>
  <button class="btn primary" type="submit">Request a perusal copy</button>
  <p class="note sent" hidden>Thank you. Your request has been sent.</p>
</form>
<div class="work-links"><a href="/works/mass-of-the-americas/">About the work</a><a href="https://benedictinstitute.org/mass-of-the-americas-composed-by-frank-la-rocca/">The Mass at the Institute</a></div>
<div class="inset" id="publishers">
<h2 class="section-title">Publishers</h2>
<ul class="pub-list">
{%- for a in affiliations %}{% if a.role == "Publisher" %}
  <li>{% if a.url %}<a href="{{ a.url }}">{{ a.name }}</a>{% else %}{{ a.name }}{% endif %}</li>
{%- endif %}{% endfor %}
</ul>
</div>
<h2 class="section-title">Commissions and unpublished works</h2>
<p>For commissions, works not yet in print, or questions about forces and editions, write through the <a href="/contact/">contact page</a>.</p>
<script>
(function(){
  document.querySelectorAll('form[action^="https://formsubmit.co/"]').forEach(function(form){
    form.addEventListener('submit',function(ev){
      ev.preventDefault();
      var btn=form.querySelector('button[type=submit]'); if(btn){btn.disabled=true; btn.dataset.label=btn.textContent; btn.textContent='Sending';}
      var data={}; new FormData(form).forEach(function(v,k){ if(k==='_next') return; if(data[k]!==undefined){data[k]+=', '+v;} else {data[k]=v;} });
      fetch(form.action.replace('formsubmit.co/','formsubmit.co/ajax/'),{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(data)})
        .then(function(r){return r.json();})
        .then(function(res){ if(!(res && (res.success==='true'||res.success===true))) throw 0;
          var n=document.createElement('p'); n.className='note form-thanks'; n.setAttribute('role','status'); n.textContent=form.dataset.thanks||'Thank you. Your message has been sent.';
          form.parentNode.replaceChild(n,form); n.scrollIntoView({block:'center'}); })
        .catch(function(){ if(btn){btn.disabled=false; btn.textContent=btn.dataset.label;} form.submit(); });
    });
  });
})();
</script>
