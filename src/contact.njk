---
layout: base.njk
title: Contact
permalink: /contact/
description: "Contact composer Frank La Rocca for commissions, performances, and press."
---
<figure class="page-banner"><img src="/images/bayeux-cathedral.jpg" alt="The nave of Bayeux Cathedral" width="1760" height="540" loading="eager"><figcaption>Bayeux Cathedral. Photograph by Frank La Rocca.</figcaption></figure>
<h1>Contact</h1>
<div class="two-up">
  <div>
    <form class="form" action="https://api.web3forms.com/submit" method="POST" data-thanks="Thank you. Your message has been sent and Frank will reply soon.">
<input type="hidden" name="access_key" value="{{ site.web3formsKey }}">
      <input type="hidden" name="subject" value="franklarocca.com contact">
      <input type="hidden" name="redirect" value="{{ site.url }}/contact/?sent=1">
      <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off">
      <label>Your name<input type="text" name="name" required autocomplete="name"></label>
      <label>Email<input type="email" name="email" required autocomplete="email"></label>
      <label>Subject<input type="text" name="subject"></label>
      <label>Message<textarea name="message" rows="7" required></textarea></label>
      <button class="btn primary" type="submit">Send</button>
      <p class="note sent" hidden>Thank you. Your message has been sent.</p>
    </form>
  </div>
  <div>
    <h2 class="section-title" style="margin-top:0">Performance materials</h2>
    <p><em>Mass of the Americas</em> and works published by Lumen Verum Music: <a href="mailto:{{ site.materialsEmail }}">{{ site.materialsEmail }}</a></p>
    <p class="note">Directors: see <a href="/directors/">For directors</a> for perusal scores and publishers.</p>
    <h2 class="section-title">Press and media</h2>
    <p>{{ site.pressAddress }}<br>{{ site.pressPhone }}</p>
    <p class="note"><a href="/press-kit/">Press kit</a> with biography and photographs.</p>
  </div>
</div>
<script>
(function(){
  document.querySelectorAll('form[action="https://api.web3forms.com/submit"]').forEach(function(form){
    form.addEventListener('submit',function(ev){
      ev.preventDefault();
      var btn=form.querySelector('button[type=submit]'); if(btn){btn.disabled=true; btn.dataset.label=btn.textContent; btn.textContent='Sending';}
      var data={}; new FormData(form).forEach(function(v,k){ if(k==='_next') return; if(data[k]!==undefined){data[k]+=', '+v;} else {data[k]=v;} });
      fetch(form.action,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:w3fBody(data)})
        .then(function(r){return r.json();})
        .then(function(res){ if(!(res && (res.success==='true'||res.success===true))) throw 0;
          var n=document.createElement('p'); n.className='note form-thanks'; n.setAttribute('role','status'); n.textContent=form.dataset.thanks||'Thank you. Your message has been sent.';
          form.parentNode.replaceChild(n,form); n.scrollIntoView({block:'center'}); })
        .catch(function(){ if(btn){btn.disabled=false; btn.textContent=btn.dataset.label;} form.submit(); });
    });
  });
})();
</script>
